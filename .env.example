# Base URL of the Padiush platform's capture API (/api/v1).
# Expo inlines EXPO_PUBLIC_* vars at build time. Copy to .env and adjust.
#
# This file governs local development only — the JS a development build runs
# comes from your Metro server, so this is the value it picks up. Release
# builds do NOT read it: `preview` and `production` set the URL in eas.json,
# so what ships is never whatever happened to be in a developer's .env.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
